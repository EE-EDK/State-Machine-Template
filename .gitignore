# Build directories
# Glob rather than a list: build-arm/ and build_runner/ existed on disk for
# months matching none of the individual entries (finding F-E), and only the
# generic *.o / *.a / CMakeFiles/ rules below were keeping their contents out.
build*/
Build/
out/
cmake-build-*/

# CMake files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake

# Compiled Object files
*.o
*.obj
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.elf
*.bin
*.hex

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# User configuration (should use template)
app_config.h

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Python
__pycache__/
*.pyc
.venv/
venv/

# Environment
.env

# Ephemeral graph outputs (root GEMINI — do not commit)
graphify-out/
**/graphify-out/
